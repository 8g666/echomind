# 将本文件复制到 .env，填好模型和客服配置，运行 docker compose up --build -d。
# 打开 http://localhost:8000/docs 验证 /health，使用 /chat 试聊。
# 把 config/knowledge.example.json 换成自己的知识库条目，通过 POST /knowledge/add 导入。
# 编辑 skills/ 中的 JSON 业务规则后，可以通过 POST /skills/reload 重载。

# 填写支持 Anthropic Messages 协议和工具调用的模型名称与 API Key。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Anthropic 官方入口留空。兼容服务填写其 Anthropic API 地址。
ANTHROPIC_BASE_URL=

# 改为自己的品牌名称和人工客服渠道。
ECHOMIND_BRAND=示例品牌
# 示例格式 ECHOMIND_HANDOFF_CONTACT="应用内的在线客服入口"
ECHOMIND_HANDOFF_CONTACT=

# Compose 默认仅向本机开放 API。
ECHOMIND_ENV=development
# 对外部署使用 production 并设置 API Token。每个 Token 至少 24 个字符。
# ECHOMIND_API_TOKENS={"替换为至少24字符的管理员令牌":{"user_id":"admin","role":"admin"}}

# 保持空知识库，直到导入自己的政策。外部 MCP 按需开启。
ECHOMIND_SEED_DEMO_DOCS=false
MCP_EXTERNAL_ENABLED=false
